{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://angular-transportes.vercel.app https://alpha4-agrominerais.vercel.app http://localhost:* http://127.0.0.1:*;"
        }
      ]
    }
  ]
}